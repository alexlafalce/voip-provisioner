<?xml version="1.0" encoding="UTF-8" ?>
<!-- Grandstream GXP Configuration -->
<!-- Generated by VOIP Provisioner -->
<!-- MAC: {{ mac | format_mac }} | Extension: {{ extension }} -->
<Settings>

  <!-- ───────────────────────────────────────────────
       Account 1
       ─────────────────────────────────────────────── -->
  <P65>1</P65>                            <!-- Account 1 active -->
  <P270>{{ display_name }}</P270>         <!-- Account 1 name -->
  <P47>{{ extension }}</P47>             <!-- SIP User ID -->
  <P36>{{ extension }}</P36>             <!-- Auth ID -->
  <P34>{{ password }}</P34>              <!-- Auth password -->
  <P52>{{ display_name }}</P52>          <!-- Display name -->

  <!-- SIP server -->
  <P2>{{ pbx_server }}</P2>              <!-- SIP proxy -->
  <P3>{{ pbx_server }}</P3>              <!-- Outbound proxy -->
  <P4>{{ pbx_port }}</P4>               <!-- SIP port -->
  <P23>3600</P23>                        <!-- Register expiry (s) -->

  <!-- Transport: 0=UDP 1=TCP 2=TLS -->
  <P142>{{ transport_code }}</P142>

  <!-- Voicemail -->
  <P33>1</P33>                           <!-- Enable MWI -->
  <P35>*97</P35>                         <!-- Voicemail number -->

  <!-- DTMF: 2 = RFC 4733 (RTP events) -->
  <P78>2</P78>

  <!-- ───────────────────────────────────────────────
       Codecs — up to 8 slots (P57–P64)
       Code: 0=PCMU 8=PCMA 9=G722 18=G729 4=G723 98=iLBC 255=disabled
       ─────────────────────────────────────────────── -->
  {% for code in codec_codes[:8] %}
  <P{{ 57 + loop.index0 }}>{{ code }}</P{{ 57 + loop.index0 }}>
  {% endfor %}
  {% for i in range(codec_codes | length, 8) %}
  <P{{ 57 + i }}>255</P{{ 57 + i }}>    <!-- disabled -->
  {% endfor %}

  <!-- ───────────────────────────────────────────────
       NAT / ICE
       ─────────────────────────────────────────────── -->
  <P52>{{ display_name }}</P52>
  <P110>0</P110>                         <!-- NAT traversal off (managed by Asterisk) -->

  <!-- ───────────────────────────────────────────────
       Time
       ─────────────────────────────────────────────── -->
  <P192>{{ ntp_server }}</P192>          <!-- NTP server -->
  <!-- P64: time zone offset in minutes — left at 0; set manually on device if needed -->

  <!-- ───────────────────────────────────────────────
       Provisioning
       ─────────────────────────────────────────────── -->
  <!-- Config server path is already set (device is downloading this file) -->
  <P237>0</P237>                         <!-- Disable randomised check-in -->
  <P284>0</P284>                         <!-- Auto-provision: 0=at boot only -->

  <!-- ───────────────────────────────────────────────
       Remote phonebook (XML)
       ─────────────────────────────────────────────── -->
  <P330>http://{{ pbx_server }}:8081/grandstream/phonebook.xml</P330>
  <P331>{{ phonebook_name | default('Directorio') }}</P331>

  <!-- ───────────────────────────────────────────────
       Accounts 2–6 disabled
       ─────────────────────────────────────────────── -->
  <P756>0</P756>   <!-- Account 2 -->
  <P1356>0</P1356> <!-- Account 3 -->
  <P1956>0</P1956> <!-- Account 4 -->
  <P2556>0</P2556> <!-- Account 5 -->
  <P3156>0</P3156> <!-- Account 6 -->

</Settings>
