<?xml version="1.0" encoding="UTF-8" ?>
<!-- Grandstream GDS37xx Door System Configuration -->
<!-- Generated by VOIP Provisioner -->
<!-- MAC: {{ mac | format_mac }} | Extension: {{ extension }} -->
<gs_provision version="1">
  <config version="1">

    <!-- SIP account -->
    <P402>{{ pbx_server }}</P402>          <!-- SIP server -->
    <P403></P403>                          <!-- Outbound proxy: none, no SBC -->
    <P404>{{ extension }}</P404>           <!-- SIP User ID -->
    <P405>{{ extension }}</P405>           <!-- Auth ID -->
    <P406>{{ password }}</P406>            <!-- Auth password -->
    <P407>{{ display_name }}</P407>        <!-- Account/Display name -->

    <!-- Transport: 0=UDP 1=TCP 2=TLS -->
    <P448>0</P448>
    <!-- DNS mode: 0=A record 1=SRV 2=NAPTR/SRV -->
    <P408>0</P408>

    <!-- DTMF -->
    <P2402>1</P2402>                       <!-- Enable RFC2833 -->
    <P2403>0</P2403>                       <!-- SIP INFO disabled -->

    <!-- Call behavior -->
    <P14580>1</P14580>                     <!-- Disable auto-answer -->
    <P14847>30</P14847>                    <!-- Ring timeout (s) -->

  </config>
</gs_provision>
